node_modules/
.npm-cache/
.venv*/
__pycache__/
*.py[cod]
/logs/
*.log
/.env
/.env.*
/scripts/service.env.cmd
/mods/.state.json
/mods/_removed/

# ── ④ 机器态与编辑器 ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
